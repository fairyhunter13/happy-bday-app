{
	"data": "# ========================================\n# Development Environment Configuration\n# Birthday Message Scheduler\n# ========================================\n\n# ----------------------------------------\n# Application\n# ----------------------------------------\nNODE_ENV=development\nPORT=3000\nHOST=localhost\nLOG_LEVEL=debug\n\n# ----------------------------------------\n# Database (PostgreSQL)\n# ----------------------------------------\nDATABASE_URL=postgres://postgres:postgres_dev_password@localhost:5432/birthday_app\nDATABASE_HOST=localhost\nDATABASE_PORT=5432\nDATABASE_USER=postgres\nDATABASE_PASSWORD=postgres_dev_password\nDATABASE_NAME=birthday_app\nDATABASE_POOL_MIN=5\nDATABASE_POOL_MAX=20\nDATABASE_SSL=false\n\n# ----------------------------------------\n# RabbitMQ\n# ----------------------------------------\nRABBITMQ_URL=amqp://rabbitmq:rabbitmq_dev_password@localhost:5672\nRABBITMQ_HOST=localhost\nRABBITMQ_PORT=5672\nRABBITMQ_USER=rabbitmq\nRABBITMQ_PASSWORD=rabbitmq_dev_password\nRABBITMQ_VHOST=/\nRABBITMQ_QUEUE_NAME=birthday-messages\nRABBITMQ_EXCHANGE_NAME=birthday-exchange\nRABBITMQ_DLX_NAME=birthday-dlx\nRABBITMQ_DLQ_NAME=birthday-dlq\n\n# ----------------------------------------\n# Redis (Optional - for caching)\n# ----------------------------------------\nREDIS_URL=redis://:redis_dev_password@localhost:6379/0\nREDIS_HOST=localhost\nREDIS_PORT=6379\nREDIS_PASSWORD=redis_dev_password\nREDIS_DB=0\n\n# ----------------------------------------\n# Email Service\n# ----------------------------------------\nEMAIL_SERVICE_URL=https://email-service.digitalenvision.com.au/send-email\nEMAIL_SERVICE_TIMEOUT=10000\n\n# ----------------------------------------\n# Queue Configuration\n# ----------------------------------------\nQUEUE_CONCURRENCY=5\nQUEUE_MAX_RETRIES=5\nQUEUE_RETRY_DELAY=2000\nQUEUE_RETRY_BACKOFF=exponential\n\n# ----------------------------------------\n# CRON Schedules\n# ----------------------------------------\nCRON_DAILY_SCHEDULE=0 0 * * *          # Daily at midnight UTC\nCRON_MINUTE_SCHEDULE=* * * * *         # Every minute\nCRON_RECOVERY_SCHEDULE=*/10 * * * *    # Every 10 minutes\n\n# ----------------------------------------\n# Circuit Breaker\n# ----------------------------------------\nCIRCUIT_BREAKER_TIMEOUT=10000\nCIRCUIT_BREAKER_ERROR_THRESHOLD=50\nCIRCUIT_BREAKER_RESET_TIMEOUT=30000\nCIRCUIT_BREAKER_VOLUME_THRESHOLD=10\n\n# ----------------------------------------\n# Rate Limiting\n# ----------------------------------------\nRATE_LIMIT_WINDOW_MS=900000  # 15 minutes\nRATE_LIMIT_MAX_REQUESTS=100\n\n# ----------------------------------------\n# Monitoring\n# ----------------------------------------\nENABLE_METRICS=true\nMETRICS_PORT=9090\n\n# ----------------------------------------\n# Development Features\n# ----------------------------------------\nENABLE_SWAGGER=true\nENABLE_SWAGGER_UI=true\nENABLE_CORS=true\nENABLE_HOT_RELOAD=true\n\n# ----------------------------------------\n# Logging\n# ----------------------------------------\nLOG_FORMAT=pretty\nLOG_PRETTY=true\nLOG_DESTINATION=stdout\n",
