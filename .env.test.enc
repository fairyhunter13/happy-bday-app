	"data": "# ========================================\n# Test Environment Configuration\n# Birthday Message Scheduler\n# ========================================\n\n# ----------------------------------------\n# Application\n# ----------------------------------------\nNODE_ENV=test\nPORT=3000\nHOST=localhost\nLOG_LEVEL=error\n\n# ----------------------------------------\n# Database (PostgreSQL - Test)\n# ----------------------------------------\nDATABASE_URL=postgres://postgres:postgres_test_password@localhost:5433/birthday_app_test\nDATABASE_HOST=localhost\nDATABASE_PORT=5433\nDATABASE_USER=postgres\nDATABASE_PASSWORD=postgres_test_password\nDATABASE_NAME=birthday_app_test\nDATABASE_POOL_MIN=2\nDATABASE_POOL_MAX=10\nDATABASE_SSL=false\n\n# ----------------------------------------\n# RabbitMQ (Test)\n# ----------------------------------------\nRABBITMQ_URL=amqp://rabbitmq:rabbitmq_test_password@localhost:5673\nRABBITMQ_HOST=localhost\nRABBITMQ_PORT=5673\nRABBITMQ_USER=rabbitmq\nRABBITMQ_PASSWORD=rabbitmq_test_password\nRABBITMQ_VHOST=/\nRABBITMQ_QUEUE_NAME=birthday-messages-test\nRABBITMQ_EXCHANGE_NAME=birthday-exchange-test\nRABBITMQ_DLX_NAME=birthday-dlx-test\nRABBITMQ_DLQ_NAME=birthday-dlq-test\n\n# ----------------------------------------\n# Redis (Test)\n# ----------------------------------------\nREDIS_URL=redis://:redis_test_password@localhost:6380/1\nREDIS_HOST=localhost\nREDIS_PORT=6380\nREDIS_PASSWORD=redis_test_password\nREDIS_DB=1\n\n# ----------------------------------------\n# Email Service (Mock)\n# ----------------------------------------\nEMAIL_SERVICE_URL=http://localhost:4000/send-email\nEMAIL_SERVICE_TIMEOUT=5000\n\n# ----------------------------------------\n# Queue Configuration\n# ----------------------------------------\nQUEUE_CONCURRENCY=2\nQUEUE_MAX_RETRIES=3\nQUEUE_RETRY_DELAY=1000\nQUEUE_RETRY_BACKOFF=exponential\n\n# ----------------------------------------\n# CRON Schedules (Disabled in tests)\n# ----------------------------------------\n